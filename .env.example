DATABASE_PATH=./.data/lonely-chat.sqlite

TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:5173/auth/twitch/callback

# Default session channel when the app has no saved channel setting yet.
TWITCH_CHANNEL_NAME=your_channel_name
# Legacy placeholder from an earlier design. The current app code does not read it.
TWITCH_CHANNEL_ID=your_channel_id

KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret
KICK_REDIRECT_URI=http://localhost:5173/auth/kick/callback

# OpenRouter API key for AI responses
OPENROUTER_KEY=your_openrouter_api_key
